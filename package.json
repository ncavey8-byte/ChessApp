{
  "name": "adaptive-chess-coach",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @acc/web dev",
    "build": "pnpm --filter @acc/web build",
    "start": "pnpm --filter @acc/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @acc/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  }
}
